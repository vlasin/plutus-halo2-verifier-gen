  advice_0: ByteArray,
  advice_1: ByteArray,
  advice_2: ByteArray,
  lookup_permuted_input: ByteArray,
  lookup_permuted_table: ByteArray,
  permutation_product_0: ByteArray,
  permutation_product_1: ByteArray,
  lookup_product: ByteArray,
  random_poly: ByteArray,
  h_0: ByteArray,
  h_1: ByteArray,
  h_2: ByteArray,
  a0_0: State<Scalar>,
  a0_1: State<Scalar>,
  a0_2: State<Scalar>,
  a0_3: State<Scalar>,
  a1_0: State<Scalar>,
  a1_1: State<Scalar>,
  a1_2: State<Scalar>,
  a1_3: State<Scalar>,
  a2_0: State<Scalar>,
  f1_0: State<Scalar>,
  f0_0: State<Scalar>,
  f2_0: State<Scalar>,
  f3_0: State<Scalar>,
  random_eval: State<Scalar>,
  p0: State<Scalar>,
  p1: State<Scalar>,
  p2: State<Scalar>,
  p3: State<Scalar>,
  z0: State<Scalar>,
  z0_next: State<Scalar>,
  z0_last: State<Scalar>,
  z1: State<Scalar>,
  z1_next: State<Scalar>,
  lookup_product_eval: State<Scalar>,
  lookup_product_next: State<Scalar>,
  lookup_input: State<Scalar>,
  lookup_input_prev: State<Scalar>,
