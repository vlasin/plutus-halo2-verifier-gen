pub type Opening {
  msm: MSM,
  evals: List<State<Scalar>>,
}

pub fn verifier(proof: Data) -> Bool {
  let p = parse_proof(proof)
  let expected_h = expected_h_eval(p)
  shplonk_pairing_check(p, expected_h)
}

fn parse_proof(proof: Data) -> ProofPieces {
  let transcript = construct_transcript(proof, transcript_rep)
  let (advice_0, transcript) = read_point(transcript)
  let (advice_1, transcript) = read_point(transcript)
  let (advice_2, transcript) = read_point(transcript)
  let (_theta, transcript) = squeeze_challenge(transcript)
  let (lookup_permuted_input, transcript) = read_point(transcript)
  let (lookup_permuted_table, transcript) = read_point(transcript)
  let (beta, transcript) = squeeze_challenge(transcript)
  let (gamma, transcript) = squeeze_challenge(transcript)
  let (permutation_product_0, transcript) = read_point(transcript)
  let (permutation_product_1, transcript) = read_point(transcript)
  let (lookup_product, transcript) = read_point(transcript)
  let (random_poly, transcript) = read_point(transcript)
  let (plonk_y, transcript) = squeeze_challenge(transcript)
  let (h_0, transcript) = read_point(transcript)
  let (h_1, transcript) = read_point(transcript)
  let (h_2, transcript) = read_point(transcript)
  let (x, transcript) = squeeze_challenge(transcript)
  let (a0_0, transcript) = read_scalar(transcript)
  let (a0_1, transcript) = read_scalar(transcript)
  let (a0_2, transcript) = read_scalar(transcript)
  let (a0_3, transcript) = read_scalar(transcript)
  let (a1_0, transcript) = read_scalar(transcript)
  let (a1_1, transcript) = read_scalar(transcript)
  let (a1_2, transcript) = read_scalar(transcript)
  let (a1_3, transcript) = read_scalar(transcript)
  let (a2_0, transcript) = read_scalar(transcript)
  let (f1_0, transcript) = read_scalar(transcript)
  let (f0_0, transcript) = read_scalar(transcript)
  let (f2_0, transcript) = read_scalar(transcript)
  let (f3_0, transcript) = read_scalar(transcript)
  let (random_eval, transcript) = read_scalar(transcript)
  let (p0, transcript) = read_scalar(transcript)
  let (p1, transcript) = read_scalar(transcript)
  let (p2, transcript) = read_scalar(transcript)
  let (p3, transcript) = read_scalar(transcript)
  let (z0, transcript) = read_scalar(transcript)
  let (z0_next, transcript) = read_scalar(transcript)
  let (z0_last, transcript) = read_scalar(transcript)
  let (z1, transcript) = read_scalar(transcript)
  let (z1_next, transcript) = read_scalar(transcript)
  let (lookup_product_eval, transcript) = read_scalar(transcript)
  let (lookup_product_next, transcript) = read_scalar(transcript)
  let (lookup_input, transcript) = read_scalar(transcript)
  let (lookup_input_prev, transcript) = read_scalar(transcript)
  let (lookup_table, transcript) = read_scalar(transcript)
  let (shplonk_y, transcript) = squeeze_challenge(transcript)
  let (v, transcript) = squeeze_challenge(transcript)
  let (shplonk_h1, transcript) = read_point(transcript)
  let (u, transcript) = squeeze_challenge(transcript)
  let (shplonk_h2, _transcript) = read_point(transcript)
  ProofPieces {
    advice_0,
    advice_1,
    advice_2,
    lookup_permuted_input,
    lookup_permuted_table,
    permutation_product_0,
    permutation_product_1,
    lookup_product,
    random_poly,
    h_0,
    h_1,
    h_2,
    a0_0,
    a0_1,
    a0_2,
    a0_3,
    a1_0,
    a1_1,
    a1_2,
    a1_3,
    a2_0,
    f1_0,
    f0_0,
    f2_0,
    f3_0,
    random_eval,
    p0,
    p1,
    p2,
    p3,
    z0,
    z0_next,
    z0_last,
    z1,
    z1_next,
    lookup_product_eval,
    lookup_product_next,
    lookup_input,
    lookup_input_prev,
    lookup_table,
    beta,
    gamma,
    plonk_y,
    x,
    shplonk_y,
    v,
    shplonk_h1,
    u,
    shplonk_h2,
  }
}

fn expected_h_eval(p: ProofPieces) -> State<Scalar> {
  let scalar_zero = from_int(0)
  let scalar_one = from_int(1)
  let xn = scalar_pow(p.x, n)
  let rotations = rotate_omegas(omega, omega_inv, -(blinding_factors + 1), 0)
  let l_evals = lagrange_polynomial_basis(p.x, xn, barycentric_weight, rotations)
  expect [l_last, l_blind_0, l_blind_1, l_blind_2, l_blind_3, l_blind_4, l_blind_5, l_0] = l_evals
  let l_blind =
    add(
      add(add(l_blind_0, l_blind_1), add(l_blind_2, l_blind_3)),
      add(l_blind_4, l_blind_5),
    )
  let active_rows = sub(scalar_one, add(l_last, l_blind))

  let gate0 = mul(p.f2_0, sub(add(p.a0_0, mul(p.a0_1, p.a0_2)), p.a0_3))
  let gate1 = mul(p.f3_0, sub(add(p.a1_0, mul(p.a1_1, p.a1_2)), p.a1_3))

  let delta2 = mul(scalar_delta, scalar_delta)
  let delta3 = mul(delta2, scalar_delta)
  let perm_first = mul(l_0, sub(scalar_one, p.z0))
  let perm_last = mul(l_last, sub(mul(p.z1, p.z1), p.z1))
  let perm_link = mul(l_0, sub(p.z1, p.z0_last))

  let perm_set0_left =
    mul(
      mul(p.z0_next, add(add(p.f1_0, mul(p.beta, p.p0)), p.gamma)),
      add(add(p.a0_0, mul(p.beta, p.p1)), p.gamma),
    )
  let perm_set0_right =
    mul(
      mul(p.z0, add(add(p.f1_0, mul(p.beta, p.x)), p.gamma)),
      add(add(p.a0_0, mul(mul(p.beta, p.x), scalar_delta)), p.gamma),
    )
  let perm_set0 = mul(active_rows, sub(perm_set0_left, perm_set0_right))

  let perm_set1_left =
    mul(
      mul(p.z1_next, add(add(p.a1_0, mul(p.beta, p.p2)), p.gamma)),
      add(add(p.a2_0, mul(p.beta, p.p3)), p.gamma),
    )
  let perm_set1_right =
    mul(
      mul(p.z1, add(add(p.a1_0, mul(mul(p.beta, p.x), delta2)), p.gamma)),
      add(add(p.a2_0, mul(mul(p.beta, p.x), delta3)), p.gamma),
    )
  let perm_set1 = mul(active_rows, sub(perm_set1_left, perm_set1_right))

  let lookup_first = mul(l_0, sub(scalar_one, p.lookup_product_eval))
  let lookup_last =
    mul(l_last, sub(mul(p.lookup_product_eval, p.lookup_product_eval), p.lookup_product_eval))
  let lookup_product_expression =
    mul(
      active_rows,
      sub(
        mul(
          mul(p.lookup_product_next, add(p.lookup_input, p.beta)),
          add(p.lookup_table, p.gamma),
        ),
        mul(
          mul(p.lookup_product_eval, add(p.a2_0, p.beta)),
          add(p.f0_0, p.gamma),
        ),
      ),
    )
  let lookup_initial = mul(l_0, sub(p.lookup_input, p.lookup_table))
  let lookup_adjacent =
    mul(
      mul(active_rows, sub(p.lookup_input, p.lookup_table)),
      sub(p.lookup_input, p.lookup_input_prev),
    )

  let folded =
    foldl(
      [
        gate0,
        gate1,
        perm_first,
        perm_last,
        perm_link,
        perm_set0,
        perm_set1,
        lookup_first,
        lookup_last,
        lookup_product_expression,
        lookup_initial,
        lookup_adjacent,
      ],
      scalar_zero,
      fn(expr, acc) { add(mul(acc, p.plonk_y), expr) },
    )
  mul(folded, recip_eea(sub_int(xn, 1)))
}

fn shplonk_pairing_check(p: ProofPieces, expected_h: State<Scalar>) -> Bool {
  let x_current = p.x
  let x_next = rotate_omega(omega, omega_inv, p.x, 1)
  let x_rot2 = rotate_omega(omega, omega_inv, p.x, 2)
  let x_rot3 = rotate_omega(omega, omega_inv, p.x, 3)
  let x_last = rotate_omega(omega, omega_inv, p.x, -(blinding_factors + 1))
  let x_prev = rotate_omega(omega, omega_inv, p.x, -1)
  let xn = scalar_pow(p.x, n)

  let points0 = [x_next, x_rot2, x_rot3, x_current]
  let z0 = vanishing(points0, p.u)
  let z0_diff_inv = recip_eea(vanishing([x_last, x_prev], p.u))

  let (msm0, r0) =
    rotation_contribution(
      points0,
      [
        point_opening(p.advice_0, [p.a0_1, p.a0_2, p.a0_3, p.a0_0]),
        point_opening(p.advice_1, [p.a1_1, p.a1_2, p.a1_3, p.a1_0]),
      ],
      p.u,
      p.shplonk_y,
      from_int(1),
      from_int(1),
    )

  let z_diff1 =
    mul(
      vanishing([x_next, x_rot2, x_rot3, x_last, x_prev], p.u),
      z0_diff_inv,
    )
  let (msm1, r1) =
    rotation_contribution(
      [x_current],
      [
        point_opening(p.advice_2, [p.a2_0]),
        point_opening(p.lookup_permuted_table, [p.lookup_table]),
        point_opening(fixed_1, [p.f1_0]),
        point_opening(fixed_0, [p.f0_0]),
        point_opening(fixed_2, [p.f2_0]),
        point_opening(fixed_3, [p.f3_0]),
        point_opening(permutation_common_0, [p.p0]),
        point_opening(permutation_common_1, [p.p1]),
        point_opening(permutation_common_2, [p.p2]),
        point_opening(permutation_common_3, [p.p3]),
        Opening { msm: vanishing_h_msm(p, xn), evals: [expected_h] },
        point_opening(p.random_poly, [p.random_eval]),
      ],
      p.u,
      p.shplonk_y,
      p.v,
      z_diff1,
    )

  let z_diff2 = mul(vanishing([x_rot2, x_rot3, x_prev], p.u), z0_diff_inv)
  let (msm2, r2) =
    rotation_contribution(
      [x_next, x_current, x_last],
      [point_opening(p.permutation_product_0, [p.z0_next, p.z0, p.z0_last])],
      p.u,
      p.shplonk_y,
      mul(p.v, p.v),
      z_diff2,
    )

  let z_diff3 = mul(vanishing([x_rot2, x_rot3, x_last, x_prev], p.u), z0_diff_inv)
  let (msm3, r3) =
    rotation_contribution(
      [x_next, x_current],
      [
        point_opening(p.permutation_product_1, [p.z1_next, p.z1]),
        point_opening(p.lookup_product, [p.lookup_product_next, p.lookup_product_eval]),
      ],
      p.u,
      p.shplonk_y,
      mul(mul(p.v, p.v), p.v),
      z_diff3,
    )

  let z_diff4 = mul(vanishing([x_next, x_rot2, x_rot3, x_last], p.u), z0_diff_inv)
  let (msm4, r4) =
    rotation_contribution(
      [x_current, x_prev],
      [point_opening(p.lookup_permuted_input, [p.lookup_input, p.lookup_input_prev])],
      p.u,
      p.shplonk_y,
      mul(mul(mul(p.v, p.v), p.v), p.v),
      z_diff4,
    )

  let outer_msm =
    add_msm(add_msm(add_msm(add_msm(msm0, msm1), msm2), msm3), msm4)
  let r_outer = add(add(add(add(r0, r1), r2), r3), r4)
  let outer_msm =
    add_msm(
      outer_msm,
      MSM {
        elements: [
          MSMElement { scalar: neg(r_outer), g1: g1_generator_bytes },
          MSMElement { scalar: neg(z0), g1: p.shplonk_h1 },
          MSMElement { scalar: p.u, g1: p.shplonk_h2 },
        ],
      },
    )

  final_exponentiation(
    miller_loop(axiom_decompress_g1(p.shplonk_h2), s_g2),
    miller_loop(eval_axiom_msm(outer_msm), generator_g2),
  )
}

fn rotation_contribution(
  points: List<State<Scalar>>,
  openings: List<Opening>,
  u: State<Scalar>,
  y: State<Scalar>,
  v_power: State<Scalar>,
  z_diff: State<Scalar>,
) -> (MSM, State<Scalar>) {
  let basis = lagrange_basis_at(points, u)
  let factor = mul(v_power, z_diff)
  let (inner_msm, r_inner) =
    rotation_contribution_go(
      openings,
      basis,
      y,
      factor,
      from_int(1),
      MSM { elements: [] },
      from_int(0),
    )
  (inner_msm, mul(factor, r_inner))
}

fn rotation_contribution_go(
  openings: List<Opening>,
  basis: List<State<Scalar>>,
  y: State<Scalar>,
  factor: State<Scalar>,
  y_power: State<Scalar>,
  msm_acc: MSM,
  r_acc: State<Scalar>,
) -> (MSM, State<Scalar>) {
  when openings is {
    [] -> (msm_acc, r_acc)
    [opening, ..rest] -> {
      let r_eval = weighted_sum(opening.evals, basis)
      rotation_contribution_go(
        rest,
        basis,
        y,
        factor,
        mul(y_power, y),
        add_scaled_msm(msm_acc, mul(factor, y_power), opening.msm),
        add(r_acc, mul(y_power, r_eval)),
      )
    }
  }
}

fn add_scaled_msm(acc: MSM, scalar: State<Scalar>, msm: MSM) -> MSM {
  MSM { elements: add_scaled_elements(msm.elements, scalar, acc.elements) }
}

fn add_scaled_elements(
  elements: List<MSMElement>,
  scalar: State<Scalar>,
  acc: List<MSMElement>,
) -> List<MSMElement> {
  when elements is {
    [] -> acc
    [element, ..rest] ->
      add_scaled_elements(
        rest,
        scalar,
        [
          MSMElement { scalar: mul(scalar, element.scalar), g1: element.g1 },
          ..acc
        ],
      )
  }
}

fn lagrange_basis_at(
  points: List<State<Scalar>>,
  x: State<Scalar>,
) -> List<State<Scalar>> {
  when points is {
    [] -> []
    [_] -> [from_int(1)]
    _ -> {
      let basis_data =
        map(
          points,
          fn(xi) {
            foldl(
              points,
              (from_int(1), from_int(1)),
              fn(xj, (num, denom)) {
                if xj == xi {
                  (num, denom)
                } else {
                  (mul(num, sub(x, xj)), mul(denom, sub(xi, xj)))
                }
              },
            )
          },
        )
      let inverted_denominators =
        batch_inverses(map(basis_data, fn((_, denom)) { denom }))
      map(
        zip(basis_data, inverted_denominators),
        fn(((num, _), denom_inv)) { mul(num, denom_inv) },
      )
    }
  }
}

fn weighted_sum(
  evals: List<State<Scalar>>,
  basis: List<State<Scalar>>,
) -> State<Scalar> {
  when evals is {
    [eval] -> eval
    _ ->
      foldl(
        zip(evals, basis),
        from_int(0),
        fn((eval, basis), acc) { add(acc, mul(eval, basis)) },
      )
  }
}

fn point_opening(point: ByteArray, evals: List<State<Scalar>>) -> Opening {
  Opening { msm: point_msm(point), evals }
}

fn point_msm(point: ByteArray) -> MSM {
  MSM {
    elements: [MSMElement { scalar: from_int(1), g1: point }],
  }
}

fn vanishing_h_msm(p: ProofPieces, xn: State<Scalar>) -> MSM {
  MSM {
    elements: [
      MSMElement { scalar: from_int(1), g1: p.h_0 },
      MSMElement { scalar: xn, g1: p.h_1 },
      MSMElement { scalar: mul(xn, xn), g1: p.h_2 },
    ],
  }
}

fn vanishing(points: List<State<Scalar>>, u: State<Scalar>) -> State<Scalar> {
  foldl(points, from_int(1), fn(point, acc) { mul(acc, sub(u, point)) })
}

fn eval_axiom_msm(msm: MSM) -> G1Element {
  foldl(
    msm.elements,
    zero_g1,
    fn(element, acc) {
      add_g1(acc, scale_g1(axiom_decompress_g1(element.g1), element.scalar))
    },
  )
}

fn axiom_decompress_g1(bytes: ByteArray) -> G1Element {
  decompress(reverse_bytes(bytes))
}

fn reverse_bytes(bytes: ByteArray) -> ByteArray {
  bytearray.foldl(bytes, #"", fn(byte, acc) { bytearray.push(acc, byte) })
}

test valid_axiom_scalar_mul_proof_benchmark() {
  verifier(proof_for_testing)
}
