{-# INLINEABLE rotationContribution #-}
rotationContribution ::
    [Scalar] ->
    [Opening] ->
    Scalar ->
    Scalar ->
    Scalar ->
    Scalar ->
    (RawMSM, Scalar)
rotationContribution points openings u' y vPower zDiff =
    let !basis = lagrangeBasisAt points u'
        !factor = vPower * zDiff
        (!innerMsm, !rInner) =
            rotationContributionGo openings basis y factor scalarOne (RawMSM []) scalarZero
     in (innerMsm, factor * rInner)

{-# INLINEABLE rotationContributionGo #-}
rotationContributionGo ::
    [Opening] ->
    [Scalar] ->
    Scalar ->
    Scalar ->
    Scalar ->
    RawMSM ->
    Scalar ->
    (RawMSM, Scalar)
rotationContributionGo [] _ _ _ _ msmAcc rAcc = (msmAcc, rAcc)
rotationContributionGo (Opening openingMsm evals : rest) basis y factor yPower msmAcc rAcc =
    let !rEval = weightedSum evals basis
     in rotationContributionGo
            rest
            basis
            y
            factor
            (yPower * y)
            (addScaledRawMsm msmAcc (factor * yPower) openingMsm)
            (rAcc + yPower * rEval)

{-# INLINEABLE addRawMsm #-}
addRawMsm :: RawMSM -> RawMSM -> RawMSM
addRawMsm (RawMSM a) (RawMSM b) = RawMSM (a <> b)

{-# INLINEABLE addScaledRawMsm #-}
addScaledRawMsm :: RawMSM -> Scalar -> RawMSM -> RawMSM
addScaledRawMsm (RawMSM acc) scalar (RawMSM elements) =
    RawMSM (foldl (\accum (RawMSMElement s p) -> RawMSMElement (scalar * s) p : accum) acc elements)

{-# INLINEABLE lagrangeBasisAt #-}
lagrangeBasisAt :: [Scalar] -> Scalar -> [Scalar]
lagrangeBasisAt [] _ = []
lagrangeBasisAt [_] _ = [scalarOne]
lagrangeBasisAt points xEval =
    let !basisData =
            map
                ( \xi ->
                    foldl
                        ( \(num, denom) xj ->
                            if xj == xi
                                then (num, denom)
                                else (num * (xEval - xj), denom * (xi - xj))
                        )
                        (scalarOne, scalarOne)
                        points
                )
                points
        !invertedDenominators = batchInverses (map (\(_, denom) -> denom) basisData)
     in map (\((num, _), denomInv) -> num * denomInv) (zip basisData invertedDenominators)

{-# INLINEABLE batchInverses #-}
batchInverses :: [Scalar] -> [Scalar]
batchInverses [] = []
batchInverses (a : aCons) =
    let !bRev = foldl (\accum elem -> elem * head accum : accum) [a] aCons
        !aRev = reverse (a : aCons)
        !bInvLast = recip (head bRev)
        (!aInvAccum, !bInv1) =
            foldl
                ( \(aInv, bInvI) (bIMin1, aI) ->
                    (bInvI * bIMin1 : aInv, bInvI * aI)
                )
                ([], bInvLast)
                (zip (tail bRev) aRev)
     in bInv1 : aInvAccum

{-# INLINEABLE weightedSum #-}
weightedSum :: [Scalar] -> [Scalar] -> Scalar
weightedSum evals basis =
    foldl (\acc (eval, basisEval) -> acc + eval * basisEval) scalarZero (zip evals basis)

{-# INLINEABLE pointOpening #-}
pointOpening :: RawPoint -> [Scalar] -> Opening
pointOpening point evals = Opening (pointMsm point) evals

{-# INLINEABLE pointMsm #-}
pointMsm :: RawPoint -> RawMSM
pointMsm point = RawMSM [RawMSMElement scalarOne point]

{-# INLINEABLE vanishingHMsm #-}
vanishingHMsm :: ProofPieces -> Scalar -> RawMSM
vanishingHMsm pieces xn =
{{{PLINTH_VANISHING_H_MSM}}}

{-# INLINEABLE vanishing #-}
vanishing :: [Scalar] -> Scalar -> Scalar
vanishing points u' = foldl (\acc point -> acc * (u' - point)) scalarOne points

{-# INLINEABLE evalAxiomMsm #-}
evalAxiomMsm :: RawMSM -> BuiltinBLS12_381_G1_Element
evalAxiomMsm (RawMSM elements) =
    foldl
        ( \acc (RawMSMElement scalar point) ->
            bls12_381_G1_add acc (bls12_381_G1_scalarMul (unScalar scalar) (axiomDecompressG1 point))
        )
        (bls12_381_G1_uncompress bls12_381_G1_compressed_zero)
        elements

{-# INLINEABLE axiomDecompressG1 #-}
axiomDecompressG1 :: RawPoint -> BuiltinBLS12_381_G1_Element
axiomDecompressG1 bytes = bls12_381_G1_uncompress (reverseByteString bytes)
