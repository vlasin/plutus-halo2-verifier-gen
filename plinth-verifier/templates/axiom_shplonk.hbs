{-# INLINEABLE verify #-}
verify :: Proof -> [Scalar] -> (Bool, [(BuiltinByteString, BlsUtils.Tracing)])
verify proof publicInputsRaw =
    case publicInputsRaw of
        {{{PLINTH_PUBLIC_INPUT_PATTERN}}} ->
            let !pieces = parseProof proof publicInputsRaw
                _ = theta pieces
                !expectedH = expectedHEval pieces publicInputsRaw
                !ok = shplonkPairingCheck pieces expectedH
             in (ok, [])
        _ -> (False, [])

{-# INLINEABLE scalarFromLittleEndianHex #-}
scalarFromLittleEndianHex :: BuiltinByteString -> Scalar
scalarFromLittleEndianHex bytes =
    mkScalar (byteStringToInteger LittleEndian bytes `modulo` bls12_381_field_prime)

{-# INLINEABLE scalarToLittleEndianBytes #-}
scalarToLittleEndianBytes :: Scalar -> BuiltinByteString
scalarToLittleEndianBytes scalar =
    integerToByteString LittleEndian 32 (unScalar scalar)

{-# INLINEABLE commonScalar #-}
commonScalar :: Scalar -> Transcript -> Transcript
commonScalar scalar transcript =
    transcript <> prefixCommon <> scalarToLittleEndianBytes scalar

{-# INLINEABLE readRawPoint #-}
readRawPoint :: ParserState -> (RawPoint, ParserState)
readRawPoint (!proof, !transcript) =
    let (!bytes, !proof') = readByteString 48 proof
     in (bytes, (proof', transcript <> prefixCommon <> bytes))

{-# INLINEABLE readScalar #-}
readScalar :: ParserState -> (Scalar, ParserState)
readScalar (!proof, !transcript) =
    let (!bytes, !proof') = readByteString 32 proof
        !scalar = scalarFromLittleEndianHex bytes
     in (scalar, (proof', transcript <> prefixCommon <> bytes))

{-# INLINEABLE squeezeChallenge #-}
squeezeChallenge :: ParserState -> (Scalar, ParserState)
squeezeChallenge (!proof, !transcript) =
    let !challengeInput = transcript <> prefixChallenge
        !hash = blake2b_256 challengeInput
        !rehash = blake2b_256 hash
        !scalar =
            scalarFromLittleEndianHex hash
                + (scalarR * scalarFromLittleEndianHex rehash)
     in (scalar, (proof, challengeInput))

