n :: Integer
n = {{{N}}}

blindingFactors :: Integer
blindingFactors = {{{BLINDING_FACTORS}}}

scalarZero :: Scalar
scalarZero = mkScalar 0

scalarOne :: Scalar
scalarOne = mkScalar 1

scalarDelta :: Scalar
scalarDelta =
    mkScalar
        (0x08634d0aa021aaf843cab354fabb0062f6502437c6a09c006c083479590189d7 `modulo` bls12_381_field_prime)

g1GeneratorBytes :: RawPoint
g1GeneratorBytes =
    stringToBuiltinByteStringHex
        "bbc622db0af03afbef1a7af93fe8556c58ac1b173f3a4ea105b974974f8c68c30faca94f8c63952694d79731a7d3f197"

transcriptRep :: Scalar
transcriptRep = scalarFromLittleEndianHex (stringToBuiltinByteStringHex "{{TRANSCRIPT_REP}}")

omega :: Scalar
omega = scalarFromLittleEndianHex (stringToBuiltinByteStringHex "{{OMEGA}}")

omegaInv :: Scalar
omegaInv = scalarFromLittleEndianHex (stringToBuiltinByteStringHex "{{OMEGA_INV}}")

barycentricWeight :: Scalar
barycentricWeight = scalarFromLittleEndianHex (stringToBuiltinByteStringHex "{{BARYCENTRIC_WEIGHT}}")

sG2 :: BuiltinBLS12_381_G2_Element
sG2 =
    bls12_381_G2_uncompress $
        stringToBuiltinByteStringHex "{{S_G2_CARDANO}}"

fixed0 :: RawPoint
fixed0 = stringToBuiltinByteStringHex "{{FIXED_0}}"

fixed1 :: RawPoint
fixed1 = stringToBuiltinByteStringHex "{{FIXED_1}}"

fixed2 :: RawPoint
fixed2 = stringToBuiltinByteStringHex "{{FIXED_2}}"

fixed3 :: RawPoint
fixed3 = stringToBuiltinByteStringHex "{{FIXED_3}}"

permutationCommon0 :: RawPoint
permutationCommon0 = stringToBuiltinByteStringHex "{{PERMUTATION_COMMON_0}}"

permutationCommon1 :: RawPoint
permutationCommon1 = stringToBuiltinByteStringHex "{{PERMUTATION_COMMON_1}}"

permutationCommon2 :: RawPoint
permutationCommon2 = stringToBuiltinByteStringHex "{{PERMUTATION_COMMON_2}}"

permutationCommon3 :: RawPoint
permutationCommon3 = stringToBuiltinByteStringHex "{{PERMUTATION_COMMON_3}}"

prefixChallenge :: BuiltinByteString
prefixChallenge = consByteString 0 emptyByteString

prefixCommon :: BuiltinByteString
prefixCommon = consByteString 1 emptyByteString

scalarR :: Scalar
scalarR =
    mkScalar
        (0x1824b159acc5056f998c4fefecbc4ff55884b7fa0003480200000001fffffffe `modulo` bls12_381_field_prime)

{-# INLINEABLE verify #-}
verify :: Proof -> (Bool, [(BuiltinByteString, BlsUtils.Tracing)])
verify proof =
    let !pieces = parseProof proof
        !expectedH = expectedHEval pieces
        !ok = shplonkPairingCheck pieces expectedH
     in (ok, [])

{-# INLINEABLE scalarFromLittleEndianHex #-}
scalarFromLittleEndianHex :: BuiltinByteString -> Scalar
scalarFromLittleEndianHex bytes =
    mkScalar (byteStringToInteger LittleEndian bytes `modulo` bls12_381_field_prime)

{-# INLINEABLE scalarToLittleEndianBytes #-}
scalarToLittleEndianBytes :: Scalar -> BuiltinByteString
scalarToLittleEndianBytes scalar =
    integerToByteString LittleEndian 32 (unScalar scalar)

{-# INLINEABLE commonScalar #-}
commonScalar :: Scalar -> Transcript -> Transcript
commonScalar scalar transcript =
    transcript <> prefixCommon <> scalarToLittleEndianBytes scalar

{-# INLINEABLE readRawPoint #-}
readRawPoint :: ParserState -> (RawPoint, ParserState)
readRawPoint (!proof, !transcript) =
    let (!bytes, !proof') = readByteString 48 proof
     in (bytes, (proof', transcript <> prefixCommon <> bytes))

{-# INLINEABLE readScalar #-}
readScalar :: ParserState -> (Scalar, ParserState)
readScalar (!proof, !transcript) =
    let (!bytes, !proof') = readByteString 32 proof
        !scalar = scalarFromLittleEndianHex bytes
     in (scalar, (proof', transcript <> prefixCommon <> bytes))

{-# INLINEABLE squeezeChallenge #-}
squeezeChallenge :: ParserState -> (Scalar, ParserState)
squeezeChallenge (!proof, !transcript) =
    let !challengeInput = transcript <> prefixChallenge
        !hash = blake2b_256 challengeInput
        !rehash = blake2b_256 hash
        !scalar =
            scalarFromLittleEndianHex hash
                + (scalarR * scalarFromLittleEndianHex rehash)
     in (scalar, (proof, challengeInput))

{-# INLINEABLE parseProof #-}
parseProof :: Proof -> ProofPieces
parseProof proof =
    let !state0 = (proof, commonScalar transcriptRep emptyByteString)
        (!advice0', !state1) = readRawPoint state0
        (!advice1', !state2) = readRawPoint state1
        (!advice2', !state3) = readRawPoint state2
        (!_theta, !state4) = squeezeChallenge state3
        (!lookupPermutedInput', !state5) = readRawPoint state4
        (!lookupPermutedTable', !state6) = readRawPoint state5
        (!beta', !state7) = squeezeChallenge state6
        (!gamma', !state8) = squeezeChallenge state7
        (!permutationProduct0', !state9) = readRawPoint state8
        (!permutationProduct1', !state10) = readRawPoint state9
        (!lookupProduct', !state11) = readRawPoint state10
        (!randomPoly', !state12) = readRawPoint state11
        (!plonkY', !state13) = squeezeChallenge state12
        (!h0', !state14) = readRawPoint state13
        (!h1', !state15) = readRawPoint state14
        (!h2', !state16) = readRawPoint state15
        (!x', !state17) = squeezeChallenge state16
        (!a0_0', !state18) = readScalar state17
        (!a0_1', !state19) = readScalar state18
        (!a0_2', !state20) = readScalar state19
        (!a0_3', !state21) = readScalar state20
        (!a1_0', !state22) = readScalar state21
        (!a1_1', !state23) = readScalar state22
        (!a1_2', !state24) = readScalar state23
        (!a1_3', !state25) = readScalar state24
        (!a2_0', !state26) = readScalar state25
        (!f1_0', !state27) = readScalar state26
        (!f0_0', !state28) = readScalar state27
        (!f2_0', !state29) = readScalar state28
        (!f3_0', !state30) = readScalar state29
        (!randomEval', !state31) = readScalar state30
        (!p0', !state32) = readScalar state31
        (!p1', !state33) = readScalar state32
        (!p2', !state34) = readScalar state33
        (!p3', !state35) = readScalar state34
        (!z0Eval', !state36) = readScalar state35
        (!z0Next', !state37) = readScalar state36
        (!z0Last', !state38) = readScalar state37
        (!z1Eval', !state39) = readScalar state38
        (!z1Next', !state40) = readScalar state39
        (!lookupProductEval', !state41) = readScalar state40
        (!lookupProductNext', !state42) = readScalar state41
        (!lookupInput', !state43) = readScalar state42
        (!lookupInputPrev', !state44) = readScalar state43
        (!lookupTable', !state45) = readScalar state44
        (!shplonkY', !state46) = squeezeChallenge state45
        (!v', !state47) = squeezeChallenge state46
        (!shplonkH1', !state48) = readRawPoint state47
        (!u', !state49) = squeezeChallenge state48
        (!shplonkH2', !_state50) = readRawPoint state49
     in ProofPieces
            advice0'
            advice1'
            advice2'
            lookupPermutedInput'
            lookupPermutedTable'
            permutationProduct0'
            permutationProduct1'
            lookupProduct'
            randomPoly'
            h0'
            h1'
            h2'
            a0_0'
            a0_1'
            a0_2'
            a0_3'
            a1_0'
            a1_1'
            a1_2'
            a1_3'
            a2_0'
            f1_0'
            f0_0'
            f2_0'
            f3_0'
            randomEval'
            p0'
            p1'
            p2'
            p3'
            z0Eval'
            z0Next'
            z0Last'
            z1Eval'
            z1Next'
            lookupProductEval'
            lookupProductNext'
            lookupInput'
            lookupInputPrev'
            lookupTable'
            beta'
            gamma'
            plonkY'
            x'
            shplonkY'
            v'
            shplonkH1'
            u'
            shplonkH2'

{-# INLINEABLE expectedHEval #-}
expectedHEval :: ProofPieces -> Scalar
expectedHEval pieces =
    let !xn = powMod (x pieces) n
        !rotateOmega = BlsUtils.rotateOmega omega omegaInv
        !rotations =
            [ rotateOmega one (-(blindingFactors + 1))
            , rotateOmega one (-(blindingFactors))
            , rotateOmega one (-(blindingFactors - 1))
            , rotateOmega one (-(blindingFactors - 2))
            , rotateOmega one (-(blindingFactors - 3))
            , rotateOmega one (-(blindingFactors - 4))
            , rotateOmega one (-(blindingFactors - 5))
            , rotateOmega one 0
            ]
        !lEvals = lagrangePolynomialBasis (x pieces) xn barycentricWeight rotations
        !lLast = lEvals !! 0
        !lBlind =
            (lEvals !! 1)
                + (lEvals !! 2)
                + (lEvals !! 3)
                + (lEvals !! 4)
                + (lEvals !! 5)
                + (lEvals !! 6)
        !l0 = lEvals !! 7
        !activeRows = scalarOne - (lLast + lBlind)
        !gate0 = f2_0 pieces * (a0_0 pieces + a0_1 pieces * a0_2 pieces - a0_3 pieces)
        !gate1 = f3_0 pieces * (a1_0 pieces + a1_1 pieces * a1_2 pieces - a1_3 pieces)
        !delta2 = scalarDelta * scalarDelta
        !delta3 = delta2 * scalarDelta
        !permFirst = l0 * (scalarOne - z0Eval pieces)
        !permLast = lLast * (z1Eval pieces * z1Eval pieces - z1Eval pieces)
        !permLink = l0 * (z1Eval pieces - z0Last pieces)
        !permSet0Left =
            z0Next pieces
                * (f1_0 pieces + beta pieces * p0 pieces + gamma pieces)
                * (a0_0 pieces + beta pieces * p1 pieces + gamma pieces)
        !permSet0Right =
            z0Eval pieces
                * (f1_0 pieces + beta pieces * x pieces + gamma pieces)
                * (a0_0 pieces + beta pieces * x pieces * scalarDelta + gamma pieces)
        !permSet0 = activeRows * (permSet0Left - permSet0Right)
        !permSet1Left =
            z1Next pieces
                * (a1_0 pieces + beta pieces * p2 pieces + gamma pieces)
                * (a2_0 pieces + beta pieces * p3 pieces + gamma pieces)
        !permSet1Right =
            z1Eval pieces
                * (a1_0 pieces + beta pieces * x pieces * delta2 + gamma pieces)
                * (a2_0 pieces + beta pieces * x pieces * delta3 + gamma pieces)
        !permSet1 = activeRows * (permSet1Left - permSet1Right)
        !lookupFirst = l0 * (scalarOne - lookupProductEval pieces)
        !lookupLast =
            lLast * (lookupProductEval pieces * lookupProductEval pieces - lookupProductEval pieces)
        !lookupProductExpression =
            activeRows
                * ( lookupProductNext pieces
                        * (lookupInput pieces + beta pieces)
                        * (lookupTable pieces + gamma pieces)
                        - lookupProductEval pieces * (a2_0 pieces + beta pieces) * (f0_0 pieces + gamma pieces)
                  )
        !lookupInitial = l0 * (lookupInput pieces - lookupTable pieces)
        !lookupAdjacent =
            activeRows
                * (lookupInput pieces - lookupTable pieces)
                * (lookupInput pieces - lookupInputPrev pieces)
        !folded =
            foldl
                (\acc expr -> acc * plonkY pieces + expr)
                scalarZero
                [ gate0
                , gate1
                , permFirst
                , permLast
                , permLink
                , permSet0
                , permSet1
                , lookupFirst
                , lookupLast
                , lookupProductExpression
                , lookupInitial
                , lookupAdjacent
                ]
     in folded * recip (xn - scalarOne)

{-# INLINEABLE shplonkPairingCheck #-}
shplonkPairingCheck :: ProofPieces -> Scalar -> Bool
shplonkPairingCheck pieces expectedH =
    let !rotateOmega = BlsUtils.rotateOmega omega omegaInv
        !xCurrent = x pieces
        !xNext = rotateOmega (x pieces) 1
        !xRot2 = rotateOmega (x pieces) 2
        !xRot3 = rotateOmega (x pieces) 3
        !xLast = rotateOmega (x pieces) (-(blindingFactors + 1))
        !xPrev = rotateOmega (x pieces) (-1)
        !xn = powMod (x pieces) n
        !points0 = [xNext, xRot2, xRot3, xCurrent]
        !z0 = vanishing points0 (u pieces)
        !z0DiffInv = recip (vanishing [xLast, xPrev] (u pieces))
        (!msm0, !r0) =
            rotationContribution
                points0
                [ pointOpening (advice0 pieces) [a0_1 pieces, a0_2 pieces, a0_3 pieces, a0_0 pieces]
                , pointOpening (advice1 pieces) [a1_1 pieces, a1_2 pieces, a1_3 pieces, a1_0 pieces]
                ]
                (u pieces)
                (shplonkY pieces)
                scalarOne
                scalarOne
        !zDiff1 = vanishing [xNext, xRot2, xRot3, xLast, xPrev] (u pieces) * z0DiffInv
        (!msm1, !r1) =
            rotationContribution
                [xCurrent]
                [ pointOpening (advice2 pieces) [a2_0 pieces]
                , pointOpening (lookupPermutedTable pieces) [lookupTable pieces]
                , pointOpening fixed1 [f1_0 pieces]
                , pointOpening fixed0 [f0_0 pieces]
                , pointOpening fixed2 [f2_0 pieces]
                , pointOpening fixed3 [f3_0 pieces]
                , pointOpening permutationCommon0 [p0 pieces]
                , pointOpening permutationCommon1 [p1 pieces]
                , pointOpening permutationCommon2 [p2 pieces]
                , pointOpening permutationCommon3 [p3 pieces]
                , Opening (vanishingHMsm pieces xn) [expectedH]
                , pointOpening (randomPoly pieces) [randomEval pieces]
                ]
                (u pieces)
                (shplonkY pieces)
                (v pieces)
                zDiff1
        !zDiff2 = vanishing [xRot2, xRot3, xPrev] (u pieces) * z0DiffInv
        (!msm2, !r2) =
            rotationContribution
                [xNext, xCurrent, xLast]
                [pointOpening (permutationProduct0 pieces) [z0Next pieces, z0Eval pieces, z0Last pieces]]
                (u pieces)
                (shplonkY pieces)
                (v pieces * v pieces)
                zDiff2
        !zDiff3 = vanishing [xRot2, xRot3, xLast, xPrev] (u pieces) * z0DiffInv
        (!msm3, !r3) =
            rotationContribution
                [xNext, xCurrent]
                [ pointOpening (permutationProduct1 pieces) [z1Next pieces, z1Eval pieces]
                , pointOpening (lookupProduct pieces) [lookupProductNext pieces, lookupProductEval pieces]
                ]
                (u pieces)
                (shplonkY pieces)
                (v pieces * v pieces * v pieces)
                zDiff3
        !zDiff4 = vanishing [xNext, xRot2, xRot3, xLast] (u pieces) * z0DiffInv
        (!msm4, !r4) =
            rotationContribution
                [xCurrent, xPrev]
                [pointOpening (lookupPermutedInput pieces) [lookupInput pieces, lookupInputPrev pieces]]
                (u pieces)
                (shplonkY pieces)
                (v pieces * v pieces * v pieces * v pieces)
                zDiff4
        !outerMsm = addRawMsm (addRawMsm (addRawMsm (addRawMsm msm0 msm1) msm2) msm3) msm4
        !rOuter = r0 + r1 + r2 + r3 + r4
        !outerMsm' =
            addRawMsm
                outerMsm
                ( RawMSM
                    [ RawMSMElement (negate rOuter) g1GeneratorBytes
                    , RawMSMElement (negate z0) (shplonkH1 pieces)
                    , RawMSMElement (u pieces) (shplonkH2 pieces)
                    ]
                )
        !g2 = bls12_381_G2_uncompress bls12_381_G2_compressed_generator
        !mlLeft = bls12_381_millerLoop (axiomDecompressG1 (shplonkH2 pieces)) sG2
        !mlRight = bls12_381_millerLoop (evalAxiomMsm outerMsm') g2
     in bls12_381_finalVerify mlLeft mlRight

{-# INLINEABLE rotationContribution #-}
rotationContribution ::
    [Scalar] ->
    [Opening] ->
    Scalar ->
    Scalar ->
    Scalar ->
    Scalar ->
    (RawMSM, Scalar)
rotationContribution points openings u' y vPower zDiff =
    let !basis = lagrangeBasisAt points u'
        !factor = vPower * zDiff
        (!innerMsm, !rInner) =
            rotationContributionGo openings basis y factor scalarOne (RawMSM []) scalarZero
     in (innerMsm, factor * rInner)

{-# INLINEABLE rotationContributionGo #-}
rotationContributionGo ::
    [Opening] ->
    [Scalar] ->
    Scalar ->
    Scalar ->
    Scalar ->
    RawMSM ->
    Scalar ->
    (RawMSM, Scalar)
rotationContributionGo [] _ _ _ _ msmAcc rAcc = (msmAcc, rAcc)
rotationContributionGo (Opening openingMsm evals : rest) basis y factor yPower msmAcc rAcc =
    let !rEval = weightedSum evals basis
     in rotationContributionGo
            rest
            basis
            y
            factor
            (yPower * y)
            (addScaledRawMsm msmAcc (factor * yPower) openingMsm)
            (rAcc + yPower * rEval)

{-# INLINEABLE addRawMsm #-}
addRawMsm :: RawMSM -> RawMSM -> RawMSM
addRawMsm (RawMSM a) (RawMSM b) = RawMSM (a <> b)

{-# INLINEABLE addScaledRawMsm #-}
addScaledRawMsm :: RawMSM -> Scalar -> RawMSM -> RawMSM
addScaledRawMsm (RawMSM acc) scalar (RawMSM elements) =
    RawMSM (foldl (\accum (RawMSMElement s p) -> RawMSMElement (scalar * s) p : accum) acc elements)

{-# INLINEABLE lagrangeBasisAt #-}
lagrangeBasisAt :: [Scalar] -> Scalar -> [Scalar]
lagrangeBasisAt [] _ = []
lagrangeBasisAt [_] _ = [scalarOne]
lagrangeBasisAt points xEval =
    let !basisData =
            map
                ( \xi ->
                    foldl
                        ( \(num, denom) xj ->
                            if xj == xi
                                then (num, denom)
                                else (num * (xEval - xj), denom * (xi - xj))
                        )
                        (scalarOne, scalarOne)
                        points
                )
                points
        !invertedDenominators = batchInverses (map (\(_, denom) -> denom) basisData)
     in map (\((num, _), denomInv) -> num * denomInv) (zip basisData invertedDenominators)

{-# INLINEABLE batchInverses #-}
batchInverses :: [Scalar] -> [Scalar]
batchInverses [] = []
batchInverses (a : aCons) =
    let !bRev = foldl (\accum elem -> elem * head accum : accum) [a] aCons
        !aRev = reverse (a : aCons)
        !bInvLast = recip (head bRev)
        (!aInvAccum, !bInv1) =
            foldl
                ( \(aInv, bInvI) (bIMin1, aI) ->
                    (bInvI * bIMin1 : aInv, bInvI * aI)
                )
                ([], bInvLast)
                (zip (tail bRev) aRev)
     in bInv1 : aInvAccum

{-# INLINEABLE weightedSum #-}
weightedSum :: [Scalar] -> [Scalar] -> Scalar
weightedSum [eval] _ = eval
weightedSum evals basis =
    foldl (\acc (eval, basisEval) -> acc + eval * basisEval) scalarZero (zip evals basis)

{-# INLINEABLE pointOpening #-}
pointOpening :: RawPoint -> [Scalar] -> Opening
pointOpening point evals = Opening (pointMsm point) evals

{-# INLINEABLE pointMsm #-}
pointMsm :: RawPoint -> RawMSM
pointMsm point = RawMSM [RawMSMElement scalarOne point]

{-# INLINEABLE vanishingHMsm #-}
vanishingHMsm :: ProofPieces -> Scalar -> RawMSM
vanishingHMsm pieces xn =
    RawMSM
        [ RawMSMElement scalarOne (h0 pieces)
        , RawMSMElement xn (h1 pieces)
        , RawMSMElement (xn * xn) (h2 pieces)
        ]

{-# INLINEABLE vanishing #-}
vanishing :: [Scalar] -> Scalar -> Scalar
vanishing points u' = foldl (\acc point -> acc * (u' - point)) scalarOne points

{-# INLINEABLE evalAxiomMsm #-}
evalAxiomMsm :: RawMSM -> BuiltinBLS12_381_G1_Element
evalAxiomMsm (RawMSM elements) =
    foldl
        ( \acc (RawMSMElement scalar point) ->
            bls12_381_G1_add acc (bls12_381_G1_scalarMul (unScalar scalar) (axiomDecompressG1 point))
        )
        (bls12_381_G1_uncompress bls12_381_G1_compressed_zero)
        elements

{-# INLINEABLE axiomDecompressG1 #-}
axiomDecompressG1 :: RawPoint -> BuiltinBLS12_381_G1_Element
axiomDecompressG1 bytes = bls12_381_G1_uncompress (reverseByteString bytes)
